# Database credentials
DB_HOST="DB_HOST"
DB_USER="DB_USER"
DB_PASSWORD="DB_PASSWORD"
DB_NAME="DB_NAME"
DB_PORT="DB_PORT"

# Telegram credentials
TELEGRAM_APITOKEN="TOKEN"
# Own telegram-bot-api (--local mode, files up to 2 GB), without a trailing
# slash. Leave it empty to use the cloud Bot API with its 20 MB file limit.
TELEGRAM_API_URL=

# AI
AI_PAINTER_HOST="HOST"
AI_LLM_URL="URL"
AI_VIDEO_HOST="HOST"
AI_TRANSCRIPTION_HOST="HOST"
# The token the generation service checks on every request. It must match
# API_TOKEN on the service host. The painter, video and transcription hosts above
# are one and the same deployment, so a single value covers all three; AI_LLM_URL
# is a different service and never receives it.
#
# Left EMPTY here on purpose, and empty is a working value: the service still
# accepts unsigned requests while the token is being rolled out, and the bot
# says so in the log once at the first request. A placeholder instead of an
# empty value would be worse — it would be sent as a real token and come back
# as 401.
AI_API_TOKEN=
TMP_CHAT_ID="TMP_CHAT_ID"

# Previews for inline results.
# PUBLIC_BASE_URL is the address the proxy exposes this bot under, without a
# trailing slash. Leave it empty and inline results simply go without previews.
PUBLIC_BASE_URL="https://bot.example.com"
THUMBNAIL_PORT="8080"
